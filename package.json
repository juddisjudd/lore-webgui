{
	"name": "lore-webui",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"gen": "bun run --cwd packages/gateway gen",
		"dev": "bun run --filter '@lore-webui/gateway' --filter '@lore-webui/web' dev",
		"build": "bun run --cwd packages/web build",
		"start": "bun run --cwd packages/gateway start",
		"check": "bun run --filter '*' check",
		"test": "bun run --filter '*' test"
	},
	"license": "MIT"
}
